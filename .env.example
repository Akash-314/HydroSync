# ==============================================================================
# HydroSync Innovations LLP — Environment Configuration Template
# Copy this file to .env.local and populate with your verified project credentials.
# NOTE: Never commit .env, .env.local, or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Configuration
# ------------------------------------------------------------------------------
# Obtain these from your Supabase Dashboard -> Project Settings -> API
# NEXT_PUBLIC_SUPABASE_URL: Your unique Supabase project URL (e.g., https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY / NEXT_PUBLIC_SUPABASE_ANON_KEY: Client-safe publishable API key.
# This key is safe to be exposed in the browser when Row Level Security (RLS) is enabled.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# SUPABASE_SERVICE_ROLE_KEY: (Optional / Server-Side Only)
# WARNING: NEVER expose this key with NEXT_PUBLIC_ or in frontend bundles.
# This key bypasses Row Level Security and is reserved for administrative tasks.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Application & Corporate Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME="HydroSync Innovations LLP"
NEXT_PUBLIC_SUPPORT_EMAIL=contact@hydrosync.in

# ------------------------------------------------------------------------------
# 3. Optional Integrations & Webhooks
# ------------------------------------------------------------------------------
# Optional external webhook URL for CRM or lead logging
LEADS_WEBHOOK_URL=

# Notification recipient email
NOTIFICATION_RECIPIENT_EMAIL=contact@hydrosync.in
